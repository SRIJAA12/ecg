# =============================================================================
# Healthcare Simulation Monitor — .gitignore
# =============================================================================
# This file tells Git which files and folders to NEVER track.
# This prevents committing generated files, secrets, and OS junk.
# =============================================================================

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.Python

# ─── Jupyter Notebooks ───────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Node / React / Vite ─────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── OS Generated ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── VS Code ─────────────────────────────────────────────────────────────────
# We keep .vscode/ shared (launch configs, recommended extensions)
# but ignore user-specific workspace state.
.vscode/*.log

# ─── Datasets (large binary files — NEVER commit raw ECG data) ───────────────
# The datasets/ folder contains raw PhysioNet downloads (MB–GB sized).
# They are downloaded via scripts/download_dataset.py and are never committed.
datasets/
# But we DO commit the empty placeholder so Git tracks the folder:
!datasets/.gitkeep
!datasets/mit-bih/.gitkeep

# ─── Waveform Library (generated output — always reproducible) ───────────────
# waveform-library/ is generated by the Python converter.
# It can always be regenerated from datasets/. Do not commit.
waveform-library/
!waveform-library/.gitkeep

# ─── Secrets / Environment ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.secret

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Coverage / Testing ──────────────────────────────────────────────────────
coverage/
.coverage
htmlcov/
.pytest_cache/
venv/
.venv/
env/

zip_extracted/
*.zip
*.h5
*.pt
*.pth
zip_extracted/
datasets/
*.zip
*.dat
*.hea
*.atr
*.xws

# Models
*.h5
*.pth
*.pt